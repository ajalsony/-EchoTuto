# EchoTutor Supabase Configuration
# Obtain your Project URL and anon public key from: https://supabase.com -> Project Settings -> API
# IMPORTANT: Only use the anon/public key in frontend code. Never expose the service_role key or database passwords.

VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-here

# Milestone 5: Server-Side AI Tutor Provider (DO NOT prefix with VITE_)
# Choose one of the following providers for server-side question generation & evaluation:

# Option A: Google Gemini (Recommended - Free Tier Available at https://aistudio.google.com)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# Option B: OpenAI (https://platform.openai.com)
# OPENAI_API_KEY=your_openai_api_key_here
# OPENAI_MODEL=gpt-4o-mini

# Option C: Groq (https://console.groq.com)
# GROQ_API_KEY=your_groq_api_key_here
# GROQ_MODEL=llama-3.3-70b-versatile
